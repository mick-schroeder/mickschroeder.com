---
import Contact from "@/components/Contact.astro";
import Button from "@/components/ui/astro/Button.astro";
import Projects from "@/components/Projects.astro";
import Socials from "@/components/Socials.astro";
import ArrowDown from "@lucide/astro/icons/arrow-down";
import type { Dictionary } from "@/i18n/config";
import type { Project } from "@/data/projects";
import type { SocialItem } from "@/data/socials";
interface Props {
  dict: Dictionary;
  projects: Project[];
  socials: SocialItem[];
  email?: string;
}
const { dict, projects, socials, email } = Astro.props;
---

<section
  class="border-b pb-10 pt-4 sm:pb-14 sm:pt-10 lg:pt-14"
  aria-labelledby="intro-heading"
>
  <p class="mb-5 text-xs font-medium tracking-wide text-primary sm:text-sm">
    {dict.intro_eyebrow}
  </p>
  <h1
    id="intro-heading"
    class="max-w-4xl text-balance font-sans text-[2.5rem] leading-[1.08] tracking-tight sm:text-6xl lg:text-7xl"
  >
    {dict.hero_heading}
  </h1>
  <div class="mt-6 flex flex-col justify-between gap-6 lg:flex-row lg:items-end lg:gap-12">
    <p class="max-w-xl text-base leading-7 text-muted-foreground sm:text-lg sm:leading-8">
      {dict.hero_body}
    </p>
    <div class="flex shrink-0 flex-wrap items-center gap-3">
      <Button href="#projects">
        {dict.cta_projects}
        <ArrowDown aria-hidden="true" />
      </Button>
      <Button href="#contact" variant="ghost">
        {dict.cta_email}
      </Button>
    </div>
  </div>
</section>

<section
  id="projects"
  class="scroll-mt-32 pt-9 sm:pt-12"
  aria-labelledby="projects-heading"
>
  <div class="mb-6 flex flex-wrap items-end justify-between gap-3 sm:mb-8">
    <div>
      <h2 id="projects-heading" class="text-2xl font-semibold tracking-tight">
        {dict.projects_heading}
      </h2>
      <p class="mt-2 max-w-xl text-sm leading-6 text-muted-foreground">
        {dict.projects_intro}
      </p>
    </div>
  </div>
  <Projects projects={projects} dict={dict} />
</section>

<div class="mt-12 grid gap-10 border-t pt-10 sm:mt-16 sm:gap-12 lg:grid-cols-[1fr_1.5fr] lg:pt-12">
  <section id="socials" class="scroll-mt-32" aria-labelledby="socials-heading">
    <h2 id="socials-heading" class="text-xl font-semibold tracking-tight">
      {dict.socials_heading}
    </h2>
    <p class="mt-2 text-sm leading-6 text-muted-foreground">
      {dict.socials_intro}
    </p>
    <Socials items={socials} dict={dict} />
  </section>
  <section id="contact" class="scroll-mt-32" aria-labelledby="contact-heading">
    <h2 id="contact-heading" class="text-xl font-semibold tracking-tight">
      {dict.contact_heading}
    </h2>
    <Contact email={email} dict={dict} />
  </section>
</div>

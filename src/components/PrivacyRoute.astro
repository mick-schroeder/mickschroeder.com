---
import MainLayout from "@/layouts/main.astro";
import Footer from "@/components/Footer.astro";
import { getDictionary, type Language } from "@/i18n/config";
import { privacySections, privacyUpdated } from "@/data/privacy";
import { siteConfig } from "@/config/site";
interface Props {
  lang: Language;
}
const { lang } = Astro.props;
const dict = getDictionary(lang);
const updated = new Intl.DateTimeFormat(lang === "ga" ? "ga-IE" : "en-US", {
  dateStyle: "long",
  timeZone: "UTC",
}).format(new Date(privacyUpdated));
---

<MainLayout
  lang={lang}
  dict={dict}
  pathname={Astro.url.pathname}
  title={dict.privacy_title}
  description={dict.privacy_description}
>
  <section class="mx-auto max-w-3xl">
    <div class="border-b py-8 sm:py-12">
      <p class="text-sm font-semibold text-primary">
        {lang === "ga" ? "Nuashonraithe" : "Last updated"}:{" "}
        <time datetime={privacyUpdated}>{updated}</time>
      </p>
      <h1 class="mt-3 font-sans text-4xl font-bold tracking-[-0.03em] sm:text-5xl">
        {dict.privacy_title}
      </h1>
      {lang === "ga" ? (
        <p class="mt-5 leading-8">
          Tá an polasaí iomlán ar fáil i mBéarla thíos.{" "}
          <a href="/privacy-policy/" hreflang="en">
            Léigh an leagan Béarla
          </a>
          . Má tá ceist agat, déan teagmháil linn trí ríomhphost.
        </p>
      ) : null}
      <p class="mt-5 leading-8" lang="en">
        This Privacy Policy explains how information may be collected, used, and
        disclosed when you visit mickschroeder.com.
      </p>
    </div>
    <div class="mt-8 space-y-6" lang="en">
      {privacySections.map((section) => (
        <section class="border-b pb-8">
          <h2 class="font-sans text-2xl font-semibold">{section.heading}</h2>
          <div class="mt-4 space-y-4 leading-8 text-muted-foreground">
            {section.body.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </section>
      ))}
      <section class="rounded-xl border bg-card p-6">
        <h2 class="font-sans text-2xl font-semibold">Contact</h2>
        <p class="mt-4 leading-8 text-muted-foreground">
          If you have any questions about this Privacy Policy, you can contact
          Mick Schroeder at{" "}
          <a href={`mailto:${siteConfig.social.email}`}>
            {siteConfig.social.email}
          </a>
          .
        </p>
      </section>
    </div>
  </section>
  <Footer lang={lang} dict={dict} />
</MainLayout>

---
import Card from "@/components/ui/astro/Card.astro";
import Button from "@/components/ui/astro/Button.astro";
import ExternalLink from "@lucide/astro/icons/external-link";
import { Picture } from "astro:assets";
import { resolveProjectAsset } from "@/lib/project-assets";
import type { Dictionary } from "@/i18n/config";
import type { Project } from "@/data/projects";

interface Props {
  projects: Project[];
  dict: Dictionary;
}

const { projects, dict } = Astro.props;
---

<div class="mt-8 grid gap-8">
  {projects.map((project, idx) => {
    const delay = `${idx * 60}ms`;
    const iconAlt = dict.project_icon.replace("{title}", project.title);
    const screenshotAlt = dict.project_screenshot.replace(
      "{title}",
      project.title,
    );
    const iconSrc = resolveProjectAsset(project.icon);
    const screenshotSrc = project.screenshot
      ? resolveProjectAsset(project.screenshot)
      : null;
    const projectLabel = project.language || dict["project_label_fallback"];
    return (
      <Card
        class="animate-rise flex h-full flex-col transition duration-200 hover:-translate-y-1 hover:shadow-lg"
        style={`animation-delay: ${delay};`}
        headerClass="hidden"
        contentClass="pt-6"
        footerClass="hidden"
      >
        <div
          slot="content"
          class="grid gap-6 lg:grid-cols-[minmax(0,1.15fr)_minmax(16rem,24rem)] lg:items-start"
        >
          <div class="flex h-full flex-col justify-between">
            <div>
              <div class="flex items-start justify-between gap-4">
                <div class="flex min-w-0 items-center gap-3">
                  {
                    <Picture
                      src={iconSrc}
                      alt={iconAlt}
                      widths={[40, 80].filter(
                        (width) => width <= iconSrc.width,
                      )}
                      sizes="40px"
                      formats={["avif", "webp"]}
                      class="h-10 w-10 min-w-10 shrink-0 object-contain rounded-xl border border-border/60"
                      loading="lazy"
                    />
                  }
                  <div class="min-w-0">
                    <h3 class="break-words text-xl sm:text-2xl font-semibold tracking-[-0.03em] text-foreground">
                      {project.title}
                    </h3>
                    <p class="mt-1 text-sm text-muted-foreground">
                      {projectLabel}
                    </p>
                  </div>
                </div>
                <span class="shrink-0 rounded-full border border-border/70 bg-background/70 px-3 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-muted-foreground">
                  {project.homepage ? dict.project_live : dict.project_archive}
                </span>
              </div>

              <p class="mt-6 text-base leading-7 text-muted-foreground">
                {project.description}
              </p>
            </div>

            <div class="mt-8 flex flex-wrap gap-3">
              {project.links?.map((link) => (
                <Button
                  href={link.url}
                  variant="outline"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {link.label}
                  <ExternalLink class="h-4 w-4" />
                </Button>
              ))}
            </div>
          </div>

          <div class="mx-auto w-full max-w-[18rem] lg:mx-0 lg:ml-auto lg:max-w-[24rem] lg:pl-2">
            {screenshotSrc ? (
              <div class="overflow-hidden rounded-[1.25rem] border border-border/60 bg-black/5 dark:bg-white/5">
                <Picture
                  src={screenshotSrc}
                  alt={screenshotAlt}
                  widths={[288, 384, 576, 768].filter(
                    (width) => width <= screenshotSrc.width,
                  )}
                  sizes="(min-width: 1024px) 384px, (max-width: 375px) calc(100vw - 96px), 288px"
                  formats={["avif", "webp"]}
                  class="aspect-[37/40] h-auto w-full object-cover object-top"
                  loading="lazy"
                />
              </div>
            ) : null}
          </div>
        </div>
      </Card>
    );
  })}
</div>

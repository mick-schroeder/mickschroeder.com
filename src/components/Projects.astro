---
import Card from "@/components/ui/astro/Card.astro";
import Badge from "@/components/ui/astro/Badge.astro";
import Button from "@/components/ui/astro/Button.astro";
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import { Picture } from "astro:assets";
import { resolveProjectAsset } from "@/lib/project-assets";
import type { Dictionary } from "@/i18n/config";
import type { Project } from "@/data/projects";
interface Props {
  projects: Project[];
  dict: Dictionary;
}
const { projects, dict } = Astro.props;
---

<div class="grid gap-5 md:grid-cols-2 sm:gap-6">
  {projects.map((project, index) => {
    const featured = index === 0;
    const icon = resolveProjectAsset(project.icon);
    const screenshot = project.screenshot
      ? resolveProjectAsset(project.screenshot)
      : null;
    if (
      project.slug === "https://github.com/mick-schroeder/mickschroeder.com"
    ) {
      return (
        <Card class="md:col-span-2 shadow-none">
          <div
            slot="content"
            class="flex flex-col justify-between gap-5 sm:flex-row sm:items-center"
          >
            <div class="flex min-w-0 items-start gap-4">
              <Picture
                src={icon}
                alt={dict.project_icon.replace("{title}", project.title)}
                widths={[40, 80].filter((width) => width <= icon.width)}
                sizes="40px"
                formats={["avif", "webp"]}
                class="h-10 w-10 min-w-10 rounded-lg object-contain"
                loading="lazy"
              />
              <div class="min-w-0">
                <h3 class="break-words text-base font-semibold tracking-tight">
                  {project.title}
                </h3>
                <p class="mt-1 text-sm leading-6 text-muted-foreground">
                  {project.description}
                </p>
              </div>
            </div>
            <div class="flex shrink-0 flex-wrap gap-2">
              {project.links.map((link) => (
                <Button
                  href={link.url}
                  size="sm"
                  variant="outline"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {link.label}
                  <ArrowUpRight aria-hidden="true" />
                </Button>
              ))}
            </div>
          </div>
        </Card>
      );
    }
    return (
      <Card
        class={
          featured ? "overflow-hidden p-0 md:col-span-2" : "overflow-hidden p-0"
        }
      >
        <div
          class={
            featured ? "grid h-full lg:grid-cols-2" : "flex h-full flex-col"
          }
        >
          <div
            class={
              featured
                ? "flex flex-col p-5 sm:p-8 lg:p-10"
                : "flex flex-1 flex-col p-5 sm:p-6"
            }
          >
            <div class="mb-5 flex items-center justify-between gap-3">
              <Picture
                src={icon}
                alt={dict.project_icon.replace("{title}", project.title)}
                widths={[40, 80].filter((width) => width <= icon.width)}
                sizes="40px"
                formats={["avif", "webp"]}
                class="h-10 w-10 min-w-10 rounded-lg object-contain"
                loading="lazy"
              />
              <Badge variant={project.homepage ? "secondary" : "outline"}>
                {project.homepage ? dict.project_live : dict.project_archive}
              </Badge>
            </div>
            <h3
              class={
                featured
                  ? "break-words text-2xl font-semibold tracking-tight sm:text-3xl"
                  : "break-words text-xl font-semibold tracking-tight"
              }
            >
              {project.title}
            </h3>
            <p class="mt-3 max-w-xl text-sm leading-6 text-muted-foreground">
              {project.description}
            </p>
            <div class="mt-5 flex flex-1 items-end">
              <p class="text-xs text-muted-foreground">
                {project.language || dict.project_label_fallback}
              </p>
            </div>
            <div class="mt-5 flex flex-wrap gap-2">
              {project.links.map((link, linkIndex) => (
                <Button
                  href={link.url}
                  size="sm"
                  variant={featured && linkIndex === 0 ? "default" : "outline"}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {link.label}
                  <ArrowUpRight aria-hidden="true" />
                </Button>
              ))}
            </div>
          </div>
          {screenshot && (
            <div
              class={
                featured
                  ? "flex items-center justify-center border-t bg-muted p-5 sm:p-8 lg:border-l lg:border-t-0"
                  : "border-t bg-muted p-5 sm:p-6"
              }
            >
              <div class="w-full overflow-hidden rounded-lg border bg-background">
                <Picture
                  src={screenshot}
                  alt={dict.project_screenshot.replace(
                    "{title}",
                    project.title,
                  )}
                  widths={[288, 384, 512, 768, 1024].filter(
                    (width) => width <= screenshot.width,
                  )}
                  sizes="(min-width: 1024px) 480px, (min-width: 768px) 320px, (min-width: 640px) 560px, calc(100vw - 88px)"
                  formats={["avif", "webp"]}
                  class="aspect-[16/10] w-full object-cover object-top"
                  loading="lazy"
                />
              </div>
            </div>
          )}
        </div>
      </Card>
    );
  })}
</div>

---
import { cn } from "@/lib/utils";
import type { HTMLAttributes } from "astro/types";
type Props = {
  className?: string;
  headerClass?: string;
  contentClass?: string;
  footerClass?: string;
} & HTMLAttributes<"article">;
const {
  class: classAttr,
  className = classAttr,
  headerClass,
  contentClass,
  footerClass,
  ...rest
} = Astro.props;
---

<article
  data-slot="card"
  class={cn(
    "flex flex-col gap-6 rounded-xl border bg-card py-6 text-card-foreground shadow-sm",
    className,
  )}
  {...rest}
>
  {Astro.slots.has("header") && (
    <div
      data-slot="card-header"
      class={cn("grid auto-rows-min items-start gap-2 px-6", headerClass)}
    >
      <slot name="header" />
    </div>
  )}
  {Astro.slots.has("content") ? (
    <div data-slot="card-content" class={cn("px-6", contentClass)}>
      <slot name="content" />
    </div>
  ) : (
    <slot />
  )}
  {Astro.slots.has("footer") && (
    <div
      data-slot="card-footer"
      class={cn("flex items-center px-6", footerClass)}
    >
      <slot name="footer" />
    </div>
  )}
</article>

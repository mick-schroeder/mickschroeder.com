---
import Monitor from "@lucide/astro/icons/monitor";
import Moon from "@lucide/astro/icons/moon";
import Sun from "@lucide/astro/icons/sun";
import { buttonVariants } from "@/components/ui/button";
import type { Dictionary } from "@/i18n/config";
interface Props {
  dict: Dictionary;
  class?: string;
}
const { dict, class: className } = Astro.props;
---

<button
  type="button"
  hidden
  class={buttonVariants({ variant: "ghost", size: "icon", className })}
  aria-label={dict.theme_cycle}
  data-theme-toggle
  data-mode="system"
  data-system={dict.theme_system}
  data-light={dict.theme_light}
  data-dark={dict.theme_dark}
  data-action={dict.theme_cycle}
>
  <span data-icon="dark" hidden>
    <Moon class="h-4 w-4" aria-hidden="true" />
  </span>
  <span data-icon="light" hidden>
    <Sun class="h-4 w-4" aria-hidden="true" />
  </span>
  <span data-icon="system">
    <Monitor class="h-4 w-4" aria-hidden="true" />
  </span>
</button>

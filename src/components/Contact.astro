---
import Button from "@/components/ui/astro/Button.astro";
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import type { Dictionary } from "@/i18n/config";
interface Props {
  email?: string;
  dict: Dictionary;
}
const { email, dict } = Astro.props;
if (!email) throw new Error("Contact component requires an email address.");
---

<p class="mt-2 max-w-lg text-sm leading-6 text-muted-foreground">
  {dict.contact_body}
</p>
<div class="mt-5">
  <Button href={`mailto:${email}`} variant="outline">
    {email}
    <ArrowUpRight aria-hidden="true" />
  </Button>
</div>

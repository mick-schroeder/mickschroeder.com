---
import type { Dictionary, Language } from "@/i18n/config";
import { languages, pathWithLang } from "@/i18n/config";
import NativeSelect from "@/components/ui/astro/NativeSelect.astro";
interface Props {
  lang: Language;
  dict: Dictionary;
  pathname: string;
}
const { lang, dict, pathname } = Astro.props;
const options = languages.map((lng) => ({
  lang: lng,
  href: pathWithLang(lng, pathname),
}));
---

<div data-language-switcher>
  <div data-language-enhanced hidden>
    <label class="sr-only" for="language-switcher">
      {dict.language_switcher_label}
    </label>
    <NativeSelect
      id="language-switcher"
      class="min-w-16 border-navbar-border bg-navbar text-navbar-foreground"
    >
      {options.map((option) => (
        <option value={option.href} selected={option.lang === lang}>
          {option.lang.toUpperCase()}
        </option>
      ))}
    </NativeSelect>
  </div>
  <div data-language-links class="flex gap-3">
    {options.map((option) => (
      <a
        href={option.href}
        lang={option.lang}
        hreflang={option.lang}
        aria-current={option.lang === lang ? "page" : undefined}
        class="inline-flex min-h-10 items-center px-2"
      >
        {option.lang.toUpperCase()}
      </a>
    ))}
  </div>
</div>
<script>
  document
    .querySelectorAll<HTMLElement>("[data-language-switcher]")
    .forEach((wrapper) => {
      const enhanced = wrapper.querySelector<HTMLElement>(
        "[data-language-enhanced]",
      );
      const links = wrapper.querySelector<HTMLElement>("[data-language-links]");
      const select = wrapper.querySelector("select");
      if (!enhanced || !links || !select) return;
      enhanced.hidden = false;
      links.hidden = true;
      select.addEventListener("change", () =>
        window.location.assign(select.value + window.location.hash),
      );
    });
</script>

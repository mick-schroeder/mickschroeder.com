{
  "name": "mickschroeder.com",
  "type": "module",
  "version": "2.0.0",
  "author": "Mick Schroeder, LLC.",
  "license": "MIT",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check && node scripts/check-content.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "test:browser": "playwright test",
    "audit:prod": "npm audit --omit=dev",
    "verify": "npm run check && npm run format:check && npm run build && npm test && npm run check:analytics && npm run audit:lighthouse",
    "prebuild": "node scripts/check-content.mjs",
    "check:analytics": "node scripts/check-analytics.mjs",
    "audit:lighthouse": "node scripts/check-lighthouse.mjs"
  },
  "dependencies": {
    "@astrojs/partytown": "^2.1.9",
    "@astrojs/sitemap": "^3.7.4",
    "@lucide/astro": "^1.66.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "lighthouse": "^13.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.5"
  },
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "allowScripts": {
    "sharp": true,
    "esbuild": true,
    "fsevents": false
  }
}
